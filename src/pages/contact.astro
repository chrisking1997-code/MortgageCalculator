---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="聯絡我們 | SmartUtilBox"
    description="對網站工具有建議、發現計算錯誤，或想詢問合作與服務，歡迎透過表單與我們聯繫。"
    currentPath="/contact"
    headerTitle="聯絡我們"
>
    <div class="px-4 py-8 max-w-7xl mx-auto space-y-8">
         <section class="py-12 lg:py-20 px-4 sm:px-6 lg:px-8"> <div class="max-w-3xl mx-auto bg-white rounded-2xl  border-none p-6 sm:p-10"> <div class="mb-10 text-center"> <h1 class="text-3xl font-bold text-slate-900 mb-4" data-i18n="contact-h1">寫下您的財務挑戰，獲取專業視角</h1> <p class="text-slate-500 leading-relaxed text-lg" data-i18n="contact-desc"> 無論是現金流卡關、對資產配置感到迷惘，還是想了解另類資產的投資邏輯。<br class="hidden sm:block"/>請寫下您目前的狀況，我會親自閱讀並給予回覆。 </p> </div> <form id="contact-form" action="https://formspree.io/f/xvzvlvwa" method="POST" class="space-y-6"> <div> <label for="name" class="block text-sm font-medium text-slate-800 mb-1" data-i18n="contact-name">姓名 (Name) *</label> <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400  outline-none transition-shadow" placeholder="王小明"> </div> <div> <label for="email" class="block text-sm font-medium text-slate-800 mb-1" data-i18n="contact-email">Email *</label> <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400  outline-none transition-shadow" placeholder="example@email.com"> </div> <div> <label for="occupation" class="block text-sm font-medium text-slate-800 mb-1" data-i18n="contact-occupation">您目前的職業/身份 (可選)</label> <input type="text" id="occupation" name="occupation" class="w-full px-4 py-3 rounded-lg border-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400  outline-none transition-shadow" placeholder="例如：軟體工程師、醫師、企業主"> </div> <div> <label for="message" class="block text-sm font-medium text-slate-800 mb-1" data-i18n="contact-message">您目前最希望優化的財務目標或遇到的挑戰是什麼？ *</label> <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg border-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400  outline-none transition-shadow resize-y" placeholder="請盡可能詳細描述您遇到的問題..."></textarea> </div> <div class="pt-4"> <button type="submit" class="w-full bg-slate-800 hover:bg-slate-700 text-white shadow-md font-bold py-4 px-8 rounded-lg shadow-md transition duration-300 transform hover:-translate-y-0.5 text-lg" data-i18n="contact-submit"> 送出需求評估 </button> </div> </form> </div> </section>

    </div>
</BaseLayout>

<script is:inline>
/* i18n Translations */ const i18n = { 'zh-tw': { 'title-contact': '寫下您的財務挑戰，獲取專業視角', 'footer-disclaimer': '試算結果僅供參考，實際貸款條件以各銀行提供為準。', 'footer-privacy': '隱私權政策', 'footer-terms': '服務條款', 'footer-guide': '理財專欄', 'contact-h1': '寫下您的財務挑戰，獲取專業視角', 'contact-desc': '無論是現金流卡關、對資產配置感到迷惘，還是想了解另類資產的投資邏輯。<br class="hidden sm:block"/>請寫下您目前的狀況，我會親自閱讀並給予回覆。', 'contact-name': '姓名 (Name) *', 'contact-email': 'Email *', 'contact-occupation': '您目前的職業/身份 (可選)', 'contact-message': '您目前最希望優化的財務目標或遇到的挑戰是什麼？ *', 'contact-submit': '送出需求評估', 'modal-title': '感謝您的提交', 'modal-desc': '您的訊息已收到，我將在 48 小時內與您聯繫。', 'modal-close': '關閉視窗' }, 'en': { 'title-contact': 'Share Your Financial Challenges', 'footer-disclaimer': 'Results are for reference only. Actual terms depend on the bank.', 'footer-privacy': 'Privacy Policy', 'footer-terms': 'Terms of Service', 'footer-guide': 'Financial Blog', 'contact-h1': 'Share Your Financial Challenges', 'contact-desc': 'Whether you are stuck with cash flow, confused about asset allocation, or want to understand alternative investments.<br class="hidden sm:block"/>Please describe your current situation, and I will personally read and reply.', 'contact-name': 'Name *', 'contact-email': 'Email *', 'contact-occupation': 'Current Occupation/Identity (Optional)', 'contact-message': 'What is the core financial goal or challenge you want to optimize? *', 'contact-submit': 'Submit Needs Assessment', 'modal-title': 'Thank You for Your Submission', 'modal-desc': 'Your message has been received, and I will contact you within 48 hours.', 'modal-close': 'Close Window' } }; /* Utilities */ function getLang() { return document.getElementById('language-selector').value; } function t(key) { return i18n[getLang()][key] || key; } function updateTranslations() { document.querySelectorAll('[data-i18n]').forEach(el => { const key = el.getAttribute('data-i18n'); if (i18n[getLang()][key]) { if (el.tagName === 'INPUT' && el.type === 'button') { el.value = i18n[getLang()][key]; } else if (el.tagName === 'DIV' || el.tagName === 'P' || el.tagName === 'H1') { el.innerHTML = i18n[getLang()][key]; } else { el.textContent = i18n[getLang()][key]; } } }); /* Update placeholders */ const lang = getLang(); if (lang === 'en') { document.getElementById('name').placeholder = 'John Doe'; document.getElementById('email').placeholder = 'example@email.com'; document.getElementById('occupation').placeholder = 'e.g. Software Engineer, Doctor, Business Owner'; document.getElementById('message').placeholder = 'Please describe your issue in detail...'; } else { document.getElementById('name').placeholder = '王小明'; document.getElementById('email').placeholder = 'example@email.com'; document.getElementById('occupation').placeholder = '例如：軟體工程師、醫師、企業主'; document.getElementById('message').placeholder = '請盡可能詳細描述您遇到的問題...'; } } document.addEventListener('DOMContentLoaded', () => { /* Setup language selector */ const langSelector = document.getElementById('language-selector'); if (langSelector) { const savedLang = localStorage.getItem('calc-lang'); if (savedLang && (savedLang === 'zh-tw' || savedLang === 'en')) { langSelector.value = savedLang; } langSelector.addEventListener('change', (e) => { localStorage.setItem('calc-lang', e.target.value); updateTranslations(); }); } /* Auto-fill email from URL parameter */ const urlParams = new URLSearchParams(window.location.search); const emailParam = urlParams.get('email'); if (emailParam) { document.getElementById('email').value = emailParam; } /* Initial render */ updateTranslations(); });
</script>
