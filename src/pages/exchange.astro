---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="SmartUtilBox | exchange">
    <div class="px-4 py-8 max-w-7xl mx-auto space-y-8">
         <section class="py-12 lg:py-16 px-4 sm:px-6 lg:px-8"> <div class="max-w-2xl mx-auto"> <!-- Calculator Card --> <div class="bg-white rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 p-6 sm:p-10 mb-8"> <div class="mb-8 text-center"> <h2 class="text-3xl font-bold text-slate-900" id="main-heading" data-i18n="exchange-h1">全球即時匯率換算器</h2> </div> <div class="space-y-6 relative"> <!-- Loading overlay --> <div id="loading-overlay" class="absolute inset-0 bg-white bg-opacity-75 z-10 flex items-center justify-center hidden rounded-xl"> <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-600"></div> </div> <!-- From Currency --> <div class="bg-slate-50 p-4 rounded-xl border-none"> <label class="block text-sm font-medium text-slate-500 mb-2" data-i18n="exchange-from">基準貨幣 (From)</label> <div class="flex flex-col sm:flex-row gap-4"> <div class="relative w-full sm:w-1/3"> <select id="from-currency" class="w-full appearance-none bg-white border-none text-slate-800 py-3 px-4 pr-8 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400 font-serif font-bold text-lg"> <option value="GBP">🇬🇧 GBP</option> <option value="USD">🇺🇸 USD</option> <option value="TWD">🇹🇼 TWD</option> <option value="JPY">🇯🇵 JPY</option> <option value="EUR">🇪🇺 EUR</option> </select> <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-800"> <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg> </div> </div> <input type="text" inputmode="numeric" id="from-amount" value="1,000" class="w-full sm:w-2/3 px-4 py-3 bg-white rounded-lg border-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400  outline-none text-right font-bold text-xl text-slate-800" placeholder="0"> </div> </div> <!-- Swap Button --> <div class="flex justify-center -my-3 relative z-0"> <button id="swap-btn" class="bg-white border-none rounded-full p-2 text-slate-500 hover:text-slate-800 transition-colors hover:bg-green-50 hover:border-emerald-600 transition-colors "> <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path></svg> </button> </div> <!-- To Currency --> <div class="bg-slate-50 p-4 rounded-xl border-none"> <label class="block text-sm font-medium text-slate-500 mb-2" data-i18n="exchange-to">目標貨幣 (To)</label> <div class="flex flex-col sm:flex-row gap-4"> <div class="relative w-full sm:w-1/3"> <select id="to-currency" class="w-full appearance-none bg-white border-none text-slate-800 py-3 px-4 pr-8 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400 font-bold text-lg"> <option value="TWD">🇹🇼 TWD</option> <option value="GBP">🇬🇧 GBP</option> <option value="USD">🇺🇸 USD</option> <option value="JPY">🇯🇵 JPY</option> <option value="EUR">🇪🇺 EUR</option> </select> <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-800"> <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg> </div> </div> <div class="w-full sm:w-2/3 px-4 py-3 bg-white rounded-lg border-none text-right font-bold text-2xl text-slate-800 overflow-hidden text-ellipsis" id="result-amount"> -- </div> </div> </div> <div class="text-right text-xs text-slate-400 mt-2" id="rate-info"> 正在獲取最新匯率... </div> </div> </div> <!-- Business Logic Banner --> <div class="bg-white rounded-2xl p-8 shadow-md text-center text-white"> <h3 class="text-2xl font-bold mb-3" data-i18n="banner-title">跨國資金流動頻繁？你需要一套更穩健的資產配置計畫。</h3> <p class="text-slate-500 mb-6 text-lg" data-i18n="banner-desc">別讓匯差與通膨吃掉你的辛勞所得。了解如何透過自動化系統，保護並擴大你的跨國資產。</p> <a href="/coaching" class="inline-block bg-slate-800 hover:bg-slate-700 text-white shadow-md font-bold py-3 px-8 rounded-full transition-colors shadow-lg shadow-slate-200/50 border border-slate-100" data-i18n="banner-btn"> 了解高薪族專屬財富系統 </a> </div> </div> </section> <!-- Quick Needs Submission Block --> <section class="bg-white py-10 border-t border-b border-slate-200 flex-shrink-0"> <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center"> <h2 class="text-2xl font-bold mb-4 text-slate-900" data-i18n="footer-cta-title">對理財有疑問？留下一句話，讓我們開始對話。</h2> <form action="/contact" method="GET" class="flex flex-col sm:flex-row justify-center gap-4 max-w-xl mx-auto"> <input type="email" name="email" placeholder="您的 Email" class="px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-400 w-full sm:w-auto flex-1 shadow-sm" required> <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-white shadow-md font-semibold px-8 py-3 rounded-md transition duration-300 w-full sm:w-auto shadow-md" data-i18n="footer-cta-btn"> 開始諮詢 </button> </form> </div> </section> <!-- Footer inside main content --> <footer class="bg-slate-50 text-white py-6 mt-auto flex-shrink-0"> <div class="container mx-auto px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center text-sm max-w-5xl"> <div class="text-center sm:text-left mb-4 sm:mb-0"> <p>&copy; 2026 SmartUtilBox. All rights reserved.</p> <p class="mt-2 text-slate-400" data-i18n="footer-disclaimer">試算結果僅供參考，實際貸款條件以各銀行提供為準。</p> </div> <div class="space-x-4"> <a href="/privacy-policy" class="hover:text-gray-300 underline" data-i18n="footer-privacy">隱私權政策</a>
                        <a href="/about" class="text-slate-500 hover:text-slate-800 underline" data-i18n="footer-about">關於</a> <a href="/disclaimer" class="text-slate-500 hover:text-slate-800 underline" data-i18n="footer-disclaimer">免責聲明</a> <a href="/terms" class="text-slate-500 hover:text-slate-800 underline" class="hover:text-gray-300 underline" data-i18n="footer-terms">服務條款</a> <a href="/blog" class="hover:text-gray-300 underline" data-i18n="footer-guide">理財專欄</a> </div> </div> </footer>
    </div>
</BaseLayout>

