---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="多國房貸利息試算中心 | SmartUtilBox"
    description="支援台灣、美國、英國專屬房貸邏輯的專業試算工具"
    currentPath="/"
    headerTitle="多國房貸利息試算中心"
>
 <div class="max-w-5xl mx-auto"> <div class="lg:hidden mb-6"> <h1 class="text-2xl font-serif font-bold text-slate-900" data-i18n="title">多國房貸利息試算中心</h1> <p class="mt-1 text-sm text-slate-500" data-i18n="subtitle">支援台灣、美國、英國專屬房貸邏輯的專業試算工具</p> </div> <div class="grid grid-cols-1 lg:grid-cols-12 gap-8"> <!-- Calculator Form --> <section class="md:col-span-4 bg-white p-6 rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 relative overflow-hidden border-none"> <div class="mb-6"> <label for="country-selector" class="block text-base font-semibold text-slate-800 mb-2" data-i18n="select-mode">請選擇國家 / 試算模式</label> <select id="country-selector" class="block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border bg-slate-50 text-slate-700 font-medium"> <option value="tw" data-i18n="opt-tw">【台灣 (寬限期模式)】</option> <option value="us" data-i18n="opt-us">【美國 (固定利率+提前還款)】</option> <option value="uk" data-i18n="opt-uk">【英國 (蜜月期轉浮動利率)】</option> </select> </div> <h2 class="text-xl font-semibold mb-4 text-slate-800" data-i18n="input-info">輸入貸款資訊</h2> <!-- Taiwan Inputs --> <form id="inputs-tw" class="mode-inputs space-y-4"> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="tw-loan">貸款總額 (NT$)</label> <input type="text" inputmode="numeric" data-type="currency" id="tw-loan-amount" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="10,000,000"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="tw-rate">年利率 (%)</label> <input type="number" id="tw-interest-rate" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="2.06" min="0" step="0.01"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="tw-term">貸款年限 (年)</label> <input type="number" id="tw-loan-term" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="30" min="1" max="50"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="tw-grace">寬限期 (年)</label> <input type="number" id="tw-grace-period" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="0" min="0" max="5"> </div> </form> <!-- US Inputs --> <form id="inputs-us" class="mode-inputs space-y-4 hidden"> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="us-loan">貸款總額 (US$)</label> <input type="text" inputmode="numeric" data-type="currency" id="us-loan-amount" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="400,000"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="us-rate">年利率 (%)</label> <input type="number" id="us-interest-rate" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="6.5" min="0" step="0.01"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="us-term">貸款年限 (年)</label> <input type="number" id="us-loan-term" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="30" min="1" max="50"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="us-extra">每月額外還款金額 (US$)</label> <input type="text" inputmode="numeric" data-type="currency" id="us-extra-payment" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="0"> </div> </form> <!-- UK Inputs --> <form id="inputs-uk" class="mode-inputs space-y-4 hidden"> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="uk-loan">貸款總額 (£)</label> <input type="text" inputmode="numeric" data-type="currency" id="uk-loan-amount" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="300,000"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="uk-term">總貸款年限 (年)</label> <input type="number" id="uk-loan-term" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="25" min="1" max="50"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="uk-intro-term">蜜月期年限 (年)</label> <input type="number" id="uk-intro-term" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="2" min="1" max="10"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="uk-intro-rate">蜜月期利率 (Intro Rate %)</label> <input type="number" id="uk-intro-rate" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="4.5" min="0" step="0.01"> </div> <div> <label class="block text-sm font-medium text-slate-800" data-i18n="uk-svr-rate">標準浮動利率 (SVR %)</label> <input type="number" id="uk-svr-rate" class="mt-1 block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border" value="7.5" min="0" step="0.01"> </div> </form> </section> <!-- Results Summary --> <section class="md:col-span-8 bg-white p-6 rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100"> <h2 class="text-xl font-semibold mb-4 text-slate-800" data-i18n="results-title">試算結果</h2> <!-- Dynamic Result Cards Area --> <div id="results-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6"> <!-- Cards will be populated by JS --> </div> <h3 class="text-lg font-semibold mb-3 text-slate-800" data-i18n="schedule-title">還款計畫表明細 (前 12 期)</h3> <div class="overflow-x-auto"> <table class="min-w-full text-left text-sm whitespace-nowrap"> <thead class="uppercase tracking-wider border-b-2 border-slate-100 bg-slate-50"> <tr> <th class="px-4 py-3 text-slate-500 font-semibold" data-i18n="th-period">期數</th> <th class="px-4 py-3 text-slate-500 font-semibold" data-i18n="th-payment">月付總額</th> <th class="px-4 py-3 text-slate-500 font-semibold" data-i18n="th-principal">償還本金</th> <th class="px-4 py-3 text-slate-500 font-semibold" data-i18n="th-interest">支付利息</th> <th class="px-4 py-3 text-slate-500 font-semibold" data-i18n="th-balance">剩餘本金</th> </tr> </thead> <tbody id="amortization-schedule" class="divide-y divide-slate-100"> <!-- Rows will be populated by JS --> </tbody> </table> </div> </section> </div> </div> <!-- Quick Needs Submission Block --> <section class="bg-white text-slate-800 shadow-sm border-b border-slate-200 py-10 border-b border-blue-800 flex-shrink-0"> <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center"> <h2 class="text-2xl font-bold mb-4" data-i18n="footer-cta-title">對理財有疑問？留下一句話，讓我們開始對話。</h2> <form action="/contact" method="GET" class="flex flex-col sm:flex-row justify-center gap-4 max-w-xl mx-auto"> <input type="email" name="email" placeholder="您的 Email" class="px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-400 w-full sm:w-auto flex-1 shadow-sm" required> <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-white shadow-md font-semibold px-8 py-3 rounded-md transition duration-300 w-full sm:w-auto shadow-md" data-i18n="footer-cta-btn"> 開始諮詢 </button> </form> </div> </section> <!-- Footer inside main content --> <footer class="bg-slate-50 text-white py-6 mt-auto flex-shrink-0"> <div class="container mx-auto px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center text-sm max-w-5xl"> <div class="text-center sm:text-left mb-4 sm:mb-0"> <p>&copy; 2026 SmartUtilBox. All rights reserved.</p> <p class="mt-2 text-slate-400" data-i18n="footer-disclaimer">試算結果僅供參考，實際貸款條件以各銀行提供為準。</p> </div> <div class="space-x-4"> <a href="/privacy-policy" class="hover:text-gray-300 underline" data-i18n="footer-privacy">隱私權政策</a>
                        <a href="/about" class="text-slate-500 hover:text-slate-800 underline" data-i18n="footer-about">關於</a> <a href="/disclaimer" class="text-slate-500 hover:text-slate-800 underline" data-i18n="footer-disclaimer">免責聲明</a> <a href="/terms" class="text-slate-500 hover:text-slate-800 underline" class="hover:text-gray-300 underline" data-i18n="footer-terms">服務條款</a> <a href="/blog" class="hover:text-gray-300 underline" data-i18n="footer-guide">理財專欄</a> </div> </div> </footer>

<script is:inline>
</script>
</BaseLayout>
