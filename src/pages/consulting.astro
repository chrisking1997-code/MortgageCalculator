---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="一對一財務規劃討論 | SmartUtilBox"
    description="預約一對一的個人財務規劃討論，主題包含房貸現金流、提早退休規劃與資產配置觀念。"
    currentPath="/consulting"
    headerTitle="預約諮詢"
>
    <div class="px-4 py-8 max-w-7xl mx-auto space-y-12">
        <!-- Hero Section -->
        <section class="bg-white rounded-2xl p-10 lg:p-16 shadow-lg shadow-slate-200/50 border border-slate-100 text-center relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-slate-800 to-slate-600"></div>
            <h1 class="text-4xl lg:text-5xl font-serif font-bold text-slate-900 mb-6" data-i18n="consult-hero-title">一對一財務規劃討論</h1>
            <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed" data-i18n="consult-hero-desc">
                用你自己的數字，一起把房貸、現金流與退休目標算清楚。討論著重在觀念釐清與試算，不提供個別證券或金融商品的買賣建議。
            </p>
        </section>

        <!-- Service Tiers -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Tier 1 -->
            <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-md hover:shadow-xl transition-shadow relative">
                <h3 class="text-2xl font-serif text-slate-900 mb-4 border-b border-slate-100 pb-4"><span data-i18n="consult-tier1-title">房貸與現金流診斷</span><br><span class="text-lg text-emerald-600 font-sans">Mortgage Checkup</span></h3>
                <p class="text-slate-600 mb-6 min-h-[80px]" data-i18n="consult-tier1-desc">一起檢視你的房貸利率、寬限期與每月現金流，試算轉貸、提前還款與不同年限的差異。</p>
                <div class="text-3xl font-bold text-slate-900 mb-6">NT$ 3,000 <span class="text-sm font-normal text-slate-500" data-i18n="consult-tier1-price">/ 45分鐘</span></div>
                <a href="/contact?service=mortgage" class="block text-center py-3 px-6 bg-slate-50 hover:bg-slate-100 border-2 border-slate-200 text-slate-900 rounded-xl font-medium transition-colors" data-i18n="consult-btn">立即預約</a>
            </div>

            <!-- Tier 2 -->
            <div class="bg-slate-900 rounded-2xl p-8 border border-slate-800 shadow-xl transform md:-translate-y-4 relative">
                
                <h3 class="text-2xl font-serif text-white mb-4 border-b border-slate-700 pb-4"><span data-i18n="consult-tier2-title">FIRE 提早退休藍圖</span><br><span class="text-lg text-amber-400 font-sans">FIRE Diagnosis</span></h3>
                <p class="text-slate-300 mb-6 min-h-[80px]" data-i18n="consult-tier2-desc">盤點收入、支出與儲蓄率，用不同報酬率與通膨假設試算達成財務自由所需的時間。</p>
                <div class="text-3xl font-bold text-white mb-6">NT$ 6,000 <span class="text-sm font-normal text-slate-400" data-i18n="consult-tier2-price">/ 90分鐘</span></div>
                <a href="/contact?service=fire" class="block text-center py-3 px-6 bg-amber-500 hover:bg-amber-400 text-slate-900 rounded-xl font-bold transition-colors" data-i18n="consult-btn">立即預約</a>
            </div>

            <!-- Tier 3 -->
            <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-md hover:shadow-xl transition-shadow relative">
                <h3 class="text-2xl font-serif text-slate-900 mb-4 border-b border-slate-100 pb-4"><span data-i18n="consult-tier3-title">資產配置觀念檢視</span><br><span class="text-lg text-blue-600 font-sans">Portfolio X-Ray</span></h3>
                <p class="text-slate-600 mb-6 min-h-[80px]" data-i18n="consult-tier3-desc">整理你目前的資產分布，討論現金比例、集中度與風險承受度等配置觀念。</p>
                <div class="text-3xl font-bold text-slate-900 mb-6">NT$ 12,000 <span class="text-sm font-normal text-slate-500" data-i18n="consult-tier3-price">/ 120分鐘</span></div>
                <a href="/contact?service=portfolio" class="block text-center py-3 px-6 bg-slate-50 hover:bg-slate-100 border-2 border-slate-200 text-slate-900 rounded-xl font-medium transition-colors" data-i18n="consult-btn">立即預約</a>
            </div>
        </section>

        <!-- Trust & Flow -->
        <section class="bg-slate-50 rounded-2xl p-10 border border-slate-200">
            <h2 class="text-3xl font-serif font-bold text-slate-900 mb-8 text-center" data-i18n="consult-flow-title">我們的服務流程</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
                <div>
                    <div class="w-16 h-16 mx-auto bg-slate-900 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-4">1</div>
                    <h4 class="font-bold text-slate-900 mb-2" data-i18n="consult-flow1-title">線上預約</h4>
                    <p class="text-sm text-slate-600" data-i18n="consult-flow1-desc">選擇適合您的方案並填寫初步問卷</p>
                </div>
                <div>
                    <div class="w-16 h-16 mx-auto bg-slate-900 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-4">2</div>
                    <h4 class="font-bold text-slate-900 mb-2" data-i18n="consult-flow2-title">資料彙整</h4>
                    <p class="text-sm text-slate-600" data-i18n="consult-flow2-desc">提供想討論的數字，讓我們事先準備試算</p>
                </div>
                <div>
                    <div class="w-16 h-16 mx-auto bg-slate-900 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-4">3</div>
                    <h4 class="font-bold text-slate-900 mb-2" data-i18n="consult-flow3-title">深度對談</h4>
                    <p class="text-sm text-slate-600" data-i18n="consult-flow3-desc">1 對 1 線上視訊討論</p>
                </div>
                <div>
                    <div class="w-16 h-16 mx-auto bg-slate-900 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-4">4</div>
                    <h4 class="font-bold text-slate-900 mb-2" data-i18n="consult-flow4-title">執行報告</h4>
                    <p class="text-sm text-slate-600" data-i18n="consult-flow4-desc">會後提供討論重點與試算摘要</p>
                </div>
            </div>
        </section>
    
        <!-- Service nature notice -->
        <section class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-sm text-amber-900 leading-relaxed">
            <h2 class="font-bold text-base mb-2" data-i18n="consult-notice-title">服務性質說明</h2>
            <p data-i18n="consult-notice-body">本服務為一般性的個人財務規劃與試算討論，屬教育與資訊性質，並非證券投資顧問服務，不會推薦、招攬或代為買賣任何特定證券、基金、保險或其他金融商品，也不保證任何投資結果。涉及具體投資、稅務或法律決定時，請諮詢具合法執照的專業人士。</p>
        </section>
</div>
</BaseLayout>
<script is:inline>
const i18nConsulting = {
    'zh-tw': {
        'consult-hero-title': '一對一財務規劃討論',
        'consult-hero-desc': '用你自己的數字，一起把房貸、現金流與退休目標算清楚。討論著重在觀念釐清與試算，不提供個別證券或金融商品的買賣建議。',
        'consult-tier1-title': '房貸與現金流診斷',
        'consult-tier1-desc': '一起檢視你的房貸利率、寬限期與每月現金流，試算轉貸、提前還款與不同年限的差異。',
        'consult-tier1-price': '/ 45分鐘',
        'consult-tier2-title': 'FIRE 提早退休藍圖',
        'consult-tier2-desc': '盤點收入、支出與儲蓄率，用不同報酬率與通膨假設試算達成財務自由所需的時間。',
        'consult-tier2-price': '/ 90分鐘',
        'consult-tier3-title': '資產配置觀念檢視',
        'consult-tier3-desc': '整理你目前的資產分布，討論現金比例、集中度與風險承受度等配置觀念。',
        'consult-tier3-price': '/ 120分鐘',
        'consult-btn': '立即預約',
        'consult-notice-title': '服務性質說明',
        'consult-notice-body': '本服務為一般性的個人財務規劃與試算討論，屬教育與資訊性質，並非證券投資顧問服務，不會推薦、招攬或代為買賣任何特定證券、基金、保險或其他金融商品，也不保證任何投資結果。涉及具體投資、稅務或法律決定時，請諮詢具合法執照的專業人士。',
        'consult-popular': '最受歡迎',
        'consult-flow-title': '我們的服務流程',
        'consult-flow1-title': '線上預約',
        'consult-flow1-desc': '選擇適合您的方案並填寫初步問卷',
        'consult-flow2-title': '資料彙整',
        'consult-flow2-desc': '提供想討論的數字，讓我們事先準備試算',
        'consult-flow3-title': '深度對談',
        'consult-flow3-desc': '1 對 1 線上視訊討論',
        'consult-flow4-title': '執行報告',
        'consult-flow4-desc': '會後提供討論重點與試算摘要',
    },
    'en': {
        'consult-hero-title': '1-on-1 Financial Planning Session',
        'consult-hero-desc': 'Work through your mortgage, cash flow and retirement numbers together. Sessions focus on concepts and calculations and do not include recommendations to buy or sell specific securities or financial products.',
        'consult-tier1-title': 'Mortgage & Cash Flow Checkup',
        'consult-tier1-desc': 'Review your mortgage rate, grace period and monthly cash flow, and compare refinancing, overpayment and loan-term scenarios.',
        'consult-tier1-price': '/ 45 mins',
        'consult-tier2-title': 'FIRE Retirement Blueprint',
        'consult-tier2-desc': 'Review income, spending and savings rate, and estimate how long financial independence takes under different return and inflation assumptions.',
        'consult-tier2-price': '/ 90 mins',
        'consult-tier3-title': 'Asset Allocation Review',
        'consult-tier3-desc': 'Map out your current asset mix and discuss cash levels, concentration and risk tolerance.',
        'consult-tier3-price': '/ 120 mins',
        'consult-btn': 'Book Now',
        'consult-notice-title': 'About this service',
        'consult-notice-body': 'Sessions are general, educational discussions of personal finance and calculations. This is not a securities investment advisory service: we do not recommend, solicit or execute trades in any specific security, fund, insurance or other financial product, and no investment outcome is guaranteed. For specific investment, tax or legal decisions, consult a licensed professional.',
        'consult-popular': 'Most Popular',
        'consult-flow-title': 'Our Service Flow',
        'consult-flow1-title': 'Online Booking',
        'consult-flow1-desc': 'Select your plan and complete the initial questionnaire',
        'consult-flow2-title': 'Data Collection',
        'consult-flow2-desc': 'Share the numbers you want to discuss so calculations can be prepared',
        'consult-flow3-title': 'Deep Dive',
        'consult-flow3-desc': '1-on-1 video call',
        'consult-flow4-title': 'Action Plan',
        'consult-flow4-desc': 'Receive a summary of the discussion and calculations',
    }
};

function updateTranslations() {
    const langSelector = document.getElementById('language-selector');
    const lang = langSelector ? langSelector.value : 'zh-tw';
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (i18nConsulting[lang] && i18nConsulting[lang][key]) {
            el.innerHTML = i18nConsulting[lang][key];
        }
    });
}

document.addEventListener('DOMContentLoaded', () => {
    const langSelector = document.getElementById('language-selector');
    if (langSelector) {
        langSelector.addEventListener('change', updateTranslations);
    }
    updateTranslations();
});
</script>
