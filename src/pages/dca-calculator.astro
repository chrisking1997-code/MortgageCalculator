---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="SmartUtilBox | dca-calculator">
    <div class="px-4 py-8 max-w-7xl mx-auto space-y-8">

            <div class="max-w-5xl mx-auto">
                <div class="lg:hidden mb-6">
                    <h1 class="text-2xl font-serif font-bold text-slate-900" data-i18n="header-title">定期定額 / 存股複利試算</h1>
                    <p class="mt-1 text-sm text-slate-500" data-i18n="header-subtitle">為您的財富建立長期的護城河</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <section class="md:col-span-4 bg-white p-6 sm:p-8 rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 relative overflow-hidden h-full">
                        <h2 class="text-xl font-serif text-slate-900 mb-6 font-semibold" data-i18n="input-title">試算設定</h2>
                        <form id="dca-form" class="space-y-5" onsubmit="return false;">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-2" data-i18n="input-initial">單筆初始投入</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-slate-500 sm:text-sm currency-symbol">$</span>
                                    </div>
                                    <input type="text" inputmode="numeric" id="initial-principal" data-type="currency" class="block w-full pl-8 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-slate-400 focus:border-slate-400 transition-colors text-right" value="100,000">
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-2" data-i18n="input-monthly">每月定期定額</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-slate-500 sm:text-sm currency-symbol">$</span>
                                    </div>
                                    <input type="text" inputmode="numeric" id="monthly-addition" data-type="currency" class="block w-full pl-8 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-slate-400 focus:border-slate-400 transition-colors text-right" value="15,000">
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-2" data-i18n="input-rate">預期年化報酬率 (%)</label>
                                    <input type="number" id="annual-rate" step="0.1" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-slate-400 focus:border-slate-400 transition-colors text-right" value="6.0">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-2" data-i18n="input-years">投資年限 (年)</label>
                                    <input type="number" id="investment-years" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-slate-400 focus:border-slate-400 transition-colors text-right" value="20">
                                </div>
                            </div>
                        </form>
                    </section>

                    <section class="md:col-span-8 flex flex-col gap-6">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="results-board">
                            <!-- Populated by JS -->
                        </div>

                        <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 flex-grow flex flex-col">
                            <h2 class="text-xl font-serif text-slate-900 mb-6 font-semibold" data-i18n="chart-title">資產成長軌跡</h2>
                            <div class="relative w-full flex-grow min-h-[400px]">
                                <canvas id="dcaChart"></canvas>
                            </div>
                        </div>

                        <div class="bg-slate-900 text-white p-8 rounded-2xl shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
                            <div class="flex-1">
                                <p class="text-lg font-serif" data-i18n="cta-text">覺得 6% 的成長速度太慢嗎？了解如何將 10% 資金佈局於實體另類資產。</p>
                            </div>
                            <a href="/portfolio-visualizer.html" class="whitespace-nowrap px-8 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-medium transition-colors shadow-lg shadow-emerald-600/30" data-i18n="cta-btn">了解進階配置</a>
                        </div>
                    </section>
                </div>
            </div>


            <!-- SEO & FAQ Section -->
            <div class="mt-12 bg-white p-8 sm:p-10 rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 mb-12 max-w-5xl mx-auto">
                <h2 class="text-2xl font-serif font-bold text-slate-900 mb-6 border-b border-slate-100 pb-3">定期定額投資的優勢與複利效應</h2>

                <div class="space-y-6 text-slate-700 leading-relaxed font-sans">
                    <p>定期定額 (Dollar-Cost Averaging, DCA) 是一種紀律性的投資策略，無論市場漲跌，投資人都在固定的時間投入固定的金額。這種策略不僅能克服人性的貪婪與恐懼，更能長遠地為您的財富建立護城河。</p>

                    <h3 class="text-xl font-semibold text-slate-800 mt-4">定期定額的「微笑曲線」原理</h3>
                    <p>許多投資人害怕在市場高點買入，但透過定期定額，您可以在高點買入較少單位，在低點買入較多單位。當市場經歷下跌後反彈時，您的平均成本會被有效攤平，這就是著名的「微笑曲線」。</p>
                    <ul class="list-disc pl-6 space-y-2 mt-2">
                        <li><strong>降低平均成本：</strong> 在熊市中累積更多單位數，加速牛市到來時的獲利速度。</li>
                        <li><strong>克服擇時難題：</strong> 放棄預測市場高低點 (Market Timing)，用紀律換取長期勝率。</li>
                        <li><strong>情緒管理：</strong> 減少因市場短期波動而做出非理性拋售的風險。</li>
                    </ul>

                    <h3 class="text-xl font-semibold text-slate-800 mt-4">複利效應 (Compound Interest) 的威力</h3>
                    <p>愛因斯坦曾說：「複利是世界第八大奇蹟。」定期定額的另一大優勢在於將獲利再投資，讓錢為您工作。時間是複利最好的朋友，越早開始，您的資產成長軌跡越會呈現指數型上升。</p>
                    <ul class="list-disc pl-6 space-y-2 mt-2">
                        <li><strong>本金與利息的雙重成長：</strong> 每年的獲利在下一年會成為產生新獲利的本金。</li>
                        <li><strong>時間的槓桿：</strong> 投資年限拉長至 10 年、20 年以上，複利帶來的利潤往往會超越您的總投入本金。</li>
                        <li><strong>對抗通膨：</strong> 只要長期預期年化報酬率高於通膨率，即可有效保護您的實質購買力。</li>
                    </ul>
                </div>
            </div>

            <!-- Quick Needs Submission Block -->
            <section class="bg-white text-slate-800 shadow-sm border-b border-slate-200 py-10 mt-12 border-b border-blue-800 flex-shrink-0">
                <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
                    <h2 class="text-2xl font-bold mb-4" data-i18n="footer-cta-title">對理財有疑問？留下一句話，讓我們開始對話。</h2>
                    <form action="/contact" method="GET" class="flex flex-col sm:flex-row justify-center gap-4 max-w-xl mx-auto">
                        <input type="email" name="email" placeholder="您的 Email" class="px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-400 w-full sm:w-auto flex-1 shadow-sm" required>
                        <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-white shadow-md font-semibold px-8 py-3 rounded-md transition duration-300 w-full sm:w-auto shadow-md" data-i18n="footer-cta-btn">
                            開始諮詢
                        </button>
                    </form>
                </div>
            </section>

            <footer class="bg-slate-50 text-white py-6 mt-auto flex-shrink-0 border-t border-slate-200">
                <div class="container mx-auto px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center text-sm max-w-5xl">
                    <div class="text-center sm:text-left mb-4 sm:mb-0">
                        <p class="text-slate-500">&copy; 2026 SmartUtilBox. All rights reserved.</p>
                    </div>
                    <div class="space-x-4">
                        <a href="/privacy-policy.html" class="text-slate-500 hover:text-slate-800 underline transition-colors" data-i18n="footer-privacy">隱私權政策</a>
                        <a href="/terms.html" class="text-slate-500 hover:text-slate-800 underline transition-colors" data-i18n="footer-terms">服務條款</a>
                        <a href="/blog" class="text-slate-500 hover:text-slate-800 underline transition-colors" data-i18n="nav-guide">理財專欄</a>
                    </div>
                </div>
            </footer>

    </div>
</BaseLayout>

<script is:inline>

const translations = {
    'zh-tw': {
        'doc-title': '定期定額 / 存股複利試算 | SmartUtilBox',
        'header-title': '定期定額 / 存股複利試算',
        'header-subtitle': '為您的財富建立長期的護城河',
        'input-title': '試算設定',
        'input-initial': '單筆初始投入',
        'input-monthly': '每月定期定額',
        'input-rate': '預期年化報酬率 (%)',
        'input-years': '投資年限 (年)',
        'chart-title': '資產成長軌跡',
        'cta-text': '覺得 6% 的成長速度太慢嗎？了解如何將 10% 資金佈局於實體另類資產。',
        'cta-btn': '了解進階配置',
        'res-principal': '總投入本金',
        'res-profit': '複利總獲利',
        'res-total': '期末總資產',
        'currency': 'TWD',
        'locale': 'zh-TW',
    },
    'en': {
        'doc-title': 'DCA Calculator | SmartUtilBox',
        'header-title': 'DCA & Compound Interest Calculator',
        'header-subtitle': 'Build a long-term moat for your wealth',
        'input-title': 'Calculator Settings',
        'input-initial': 'Initial Principal',
        'input-monthly': 'Monthly Addition',
        'input-rate': 'Expected Annual Rate (%)',
        'input-years': 'Investment Term (Years)',
        'chart-title': 'Wealth Growth Trajectory',
        'cta-text': 'Think 6% growth is too slow? Learn how to allocate 10% of your funds into physical alternative assets.',
        'cta-btn': 'Explore Advanced Allocation',
        'res-principal': 'Total Principal',
        'res-profit': 'Compound Profit',
        'res-total': 'Final Total Asset',
        'currency': 'USD',
        'locale': 'en-US',
    }
};

const sidebar = document.getElementById('sidebar');
const openSidebarBtn = document.getElementById('open-sidebar');
const closeSidebarBtn = document.getElementById('close-sidebar');
const sidebarOverlay = document.getElementById('sidebar-overlay');

function openSidebar() {
    if(sidebar) sidebar.classList.remove('-translate-x-full');
    if(sidebarOverlay) sidebarOverlay.classList.remove('hidden');
}

function closeSidebar() {
    if(sidebar) sidebar.classList.add('-translate-x-full');
    if(sidebarOverlay) sidebarOverlay.classList.add('hidden');
}

if(openSidebarBtn) openSidebarBtn.addEventListener('click', openSidebar);
if(closeSidebarBtn) closeSidebarBtn.addEventListener('click', closeSidebar);
if(sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

function getLang() {
    const selector = document.getElementById('language-selector');
    return selector ? selector.value : 'zh-tw';
}

function t(key) {
    const lang = getLang();
    return translations[lang][key] !== undefined ? translations[lang][key] : key;
}

function formatCurrency(amount) {
    const locale = t('locale');
    const currency = t('currency');
    return new Intl.NumberFormat(locale, { style: 'currency', currency: currency, maximumFractionDigits: 0 }).format(amount);
}

function formatNumberWithCommas(value) {
    const num = String(value).replace(/\D/g, "");
    return num.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}

function getNumericValue(elementId) {
    const el = document.getElementById(elementId);
    if (!el) return 0;
    const val = String(el.value).replace(/\D/g, "");
    return parseFloat(val) || 0;
}

function createResultCard(title, value, colorClass) {
    return `
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-lg shadow-slate-200/50 transition-all hover:shadow-md flex flex-col justify-center">
            <h3 class="text-sm font-medium text-slate-500 mb-2">${title}</h3>
            <p class="text-2xl font-serif font-bold ${colorClass} break-words">${value}</p>
        </div>
    `;
}

let dcaChart = null;

function renderChart(labels, principalData, profitData) {
    const canvas = document.getElementById('dcaChart');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    if (dcaChart) {
        dcaChart.destroy();
    }

    Chart.defaults.font.family = '"Inter", "Noto Sans TC", sans-serif';

    dcaChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: t('res-principal'),
                    data: principalData,
                    backgroundColor: '#334155',
                    borderWidth: 0,
                },
                {
                    label: t('res-profit'),
                    data: profitData,
                    backgroundColor: '#10b981',
                    borderWidth: 0,
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { stacked: true, grid: { display: false } },
                y: {
                    stacked: true,
                    border: { display: false },
                    grid: { color: '#f1f5f9' },
                    ticks: {
                        callback: function(value) {
                            if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
                            if (value >= 10000) return (value / 10000).toFixed(0) + '萬';
                            return value;
                        }
                    }
                }
            },
            plugins: {
                legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } },
                tooltip: {
                    mode: 'index', intersect: false,
                    callbacks: {
                        label: function(context) {
                            let label = context.dataset.label || '';
                            if (label) label += ': ';
                            if (context.parsed.y !== null) {
                                label += new Intl.NumberFormat(t('locale'), { style: 'currency', currency: t('currency'), maximumFractionDigits: 0 }).format(context.parsed.y);
                            }
                            return label;
                        }
                    }
                }
            }
        }
    });
}

function calculateDCA() {
    const initialPrincipal = getNumericValue('initial-principal');
    const monthlyAddition = getNumericValue('monthly-addition');
    const annualRateEl = document.getElementById('annual-rate');
    const yearsEl = document.getElementById('investment-years');

    const annualRate = annualRateEl ? parseFloat(annualRateEl.value) || 0 : 0;
    const years = yearsEl ? parseInt(yearsEl.value) || 0 : 0;

    const monthlyRate = (annualRate / 100) / 12;
    const totalMonths = years * 12;

    let currentBalance = initialPrincipal;
    let totalPrincipal = initialPrincipal;

    let labels = [];
    let principalData = [];
    let profitData = [];

    for (let month = 1; month <= totalMonths; month++) {
        currentBalance = currentBalance * (1 + monthlyRate) + monthlyAddition;
        totalPrincipal += monthlyAddition;

        if (month % 12 === 0) {
            const year = month / 12;
            labels.push(`Year ${year}`);
            principalData.push(totalPrincipal);
            profitData.push(currentBalance - totalPrincipal);
        }
    }

    const totalProfit = currentBalance - totalPrincipal;

    const resultsBoard = document.getElementById('results-board');
    if (resultsBoard) {
        resultsBoard.innerHTML =
            createResultCard(t('res-principal'), formatCurrency(totalPrincipal), 'text-slate-900') +
            createResultCard(t('res-profit'), formatCurrency(totalProfit), 'text-emerald-600') +
            createResultCard(t('res-total'), formatCurrency(currentBalance), 'text-slate-900');
    }

    renderChart(labels, principalData, profitData);
}

function updateTranslations() {
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[getLang()] && translations[getLang()][key] !== undefined) {
            el.textContent = translations[getLang()][key];
        }
    });

    document.title = t('doc-title');
    document.documentElement.lang = getLang();

    const symbol = getLang() === 'zh-tw' ? '$' : '$';
    document.querySelectorAll('.currency-symbol').forEach(el => el.textContent = symbol);

    calculateDCA();
}

document.addEventListener('DOMContentLoaded', () => {
    const langSelector = document.getElementById('language-selector');
    if (langSelector) {
        const savedLang = localStorage.getItem('calc-lang');
        if (savedLang && (savedLang === 'zh-tw' || savedLang === 'en')) {
            langSelector.value = savedLang;
        }
        langSelector.addEventListener('change', (e) => {
            localStorage.setItem('calc-lang', e.target.value);
            updateTranslations();
        });
    }

    const inputs = document.querySelectorAll('#dca-form input');
    inputs.forEach(input => {
        if (input.getAttribute('data-type') === 'currency') {
            input.addEventListener('input', (e) => {
                let cursorPosition = e.target.selectionStart;
                let originalLength = e.target.value.length;
                e.target.value = formatNumberWithCommas(e.target.value);
                let newLength = e.target.value.length;
                cursorPosition = cursorPosition + (newLength - originalLength);
                e.target.setSelectionRange(cursorPosition, cursorPosition);
            });
        }
        input.addEventListener('input', calculateDCA);
    });

    updateTranslations();
});

</script>
