---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const ids = new Set(blogEntries.map((e) => e.id));
  return blogEntries.map((entry) => {
    const isEn = entry.id.startsWith('en-');
    const counterpart = isEn ? entry.id.slice(3) : `en-${entry.id}`;
    return {
      params: { slug: entry.id },
      props: { entry, isEn, counterpart: ids.has(counterpart) ? counterpart : null },
    };
  });
}

const { entry, isEn, counterpart } = Astro.props;
const { Content } = await render(entry);
const site = Astro.site ?? new URL('https://www.smartutilbox.com');
const url = new URL(`/blog/${entry.id}/`, site).href;
const published = entry.data.pubDate.toISOString().slice(0, 10);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: published,
  inLanguage: isEn ? 'en' : 'zh-TW',
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: entry.data.author ?? 'SmartUtilBox' },
  publisher: { '@type': 'Organization', name: 'SmartUtilBox' },
};
---

<BaseLayout
  title={`${entry.data.title} | SmartUtilBox`}
  description={entry.data.description}
  currentPath="/blog"
  headerTitle={isEn ? 'Financial Blog' : '理財專欄'}
  lang={isEn ? 'en' : 'zh-TW'}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="bg-white p-6 sm:p-8 lg:p-12 rounded-xl shadow-lg shadow-slate-200/50 border border-slate-100 max-w-4xl mx-auto text-slate-800 border-t-4 border-emerald-600 mt-4 lg:mt-8 mb-8">

      <a href="/blog" class="inline-flex items-center mb-8 px-4 py-2 bg-slate-50 hover:bg-slate-100 text-slate-600 hover:text-slate-900 rounded-full text-sm font-medium transition-all group border border-slate-200">
          <svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <span>{isEn ? 'Back to Blog List' : '返回專欄列表'}</span>
      </a>

      <h1 class="text-3xl lg:text-4xl font-extrabold text-slate-800 leading-tight mb-4">
          {entry.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500 mb-8 border-b pb-4 border-slate-100">
          <span>{isEn ? 'Published: ' : '發布日期：'}<time datetime={published}>{published}</time></span>
          {entry.data.author && <span>{isEn ? 'Author: ' : '作者：'}{entry.data.author}</span>}
          {counterpart && (
            <a href={`/blog/${counterpart}/`} hreflang={isEn ? 'zh-TW' : 'en'} class="underline hover:text-slate-800">
              {isEn ? '閱讀中文版' : 'Read in English'}
            </a>
          )}
      </div>
      <div class="prose prose-slate prose-lg max-w-prose mx-auto leading-relaxed prose-headings:text-slate-900 prose-a:text-emerald-700 prose-a:font-semibold hover:prose-a:underline prose-h2:mt-12 prose-h2:mb-4 prose-h3:mt-8 prose-h3:mb-3 prose-blockquote:border-l-4 prose-blockquote:border-emerald-600 prose-blockquote:bg-slate-50 prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-slate-700">
          <Content />
      </div>

      <aside class="mt-12 bg-slate-50 border border-slate-200 rounded-xl p-5 text-sm text-slate-600 leading-relaxed">
          {isEn
            ? 'This article reflects the author\'s personal views and experience and is for educational purposes only. It is not investment advice or a recommendation to buy or sell any financial product. All investments carry risk, and past performance does not guarantee future results.'
            : '本文為作者個人觀點與經驗分享，僅供教育參考，不構成任何投資建議，亦非買賣任何金融商品的推薦。投資必有風險，過去績效不代表未來表現，請自行審慎評估。'}
      </aside>
  </article>

<script is:inline define:vars={{ counterpart, isEn }}>
    document.addEventListener('DOMContentLoaded', () => {
        const selector = document.getElementById('language-selector');
        if (!selector) return;
        selector.value = isEn ? 'en' : 'zh-tw';
        selector.addEventListener('change', (e) => {
            const wantEn = e.target.value === 'en';
            if (wantEn !== isEn && counterpart) {
                window.location.href = `/blog/${counterpart}/`;
            }
        });
    });
</script>

</BaseLayout>
