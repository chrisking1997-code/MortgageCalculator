---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="財富實驗室專欄 (Insights & Research) | SmartUtilBox" currentPath="/blog" headerTitle="SmartUtilBox 理財專欄">
  <div class="max-w-4xl mx-auto">
      <div class="lg:hidden mb-6">
          <h1 class="text-2xl font-serif font-bold text-slate-900" data-i18n="header-title">財富實驗室專欄 (Insights & Research)</h1>
          <p class="mt-1 text-sm text-slate-500" data-i18n="header-subtitle">聰明理財，穩健投資</p>
      </div>

      <div class="grid gap-8">
        {allPosts.map((post) => (
          <article class="bg-white p-8 rounded-lg shadow-md max-w-none text-slate-800 space-y-4 flex flex-col transition-shadow hover:shadow-lg">
            <a href={`/blog/${post.id}`} class="hover:text-emerald-700 transition-colors">
              <h2 class="text-2xl font-serif font-bold text-slate-900 mb-2">{post.data.title}</h2>
            </a>
            <p class="text-sm text-slate-500 mb-4">發布日期：{post.data.pubDate.toISOString().slice(0, 10)}</p>
            <a href={`/blog/${post.id}`} class="block hover:opacity-80 transition-opacity">
              <p class="leading-relaxed">{post.data.description}</p>
            </a>
            <div class="mt-6 pt-4 border-t border-slate-100">
              <a href={`/blog/${post.id}`} class="inline-block px-6 py-2 bg-white text-slate-800 shadow-sm border-b border-slate-200 text-sm font-medium rounded hover:bg-slate-100 transition-colors">閱讀更多</a>
            </div>
          </article>
        ))}
      </div>

      <!-- Quick Needs Submission Block -->
      <section class="bg-white text-slate-800 shadow-sm border-b border-slate-200 py-10 border-b border-blue-800 flex-shrink-0 mt-12 rounded-xl">
          <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
              <h2 class="text-2xl font-bold mb-4" data-i18n="footer-cta-title">對理財有疑問？留下一句話，讓我們開始對話。</h2>
              <form action="/contact" method="GET" class="flex flex-col sm:flex-row justify-center gap-4 max-w-xl mx-auto">
                  <input type="email" name="email" placeholder="您的 Email" class="px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-400 w-full sm:w-auto flex-1 shadow-sm" required>
                  <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-white shadow-md font-semibold px-8 py-3 rounded-md transition duration-300 w-full sm:w-auto shadow-md" data-i18n="footer-cta-btn">
                      開始諮詢
                  </button>
              </form>
          </div>
      </section>

      <!-- Footer inside main content -->
      <footer class="bg-slate-50 text-white py-6 mt-12 flex-shrink-0 rounded-t-xl">
          <div class="container mx-auto px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center text-sm max-w-4xl">
              <div class="text-center sm:text-left mb-4 sm:mb-0">
                  <p class="text-slate-500">&copy; 2026 SmartUtilBox. All rights reserved.</p>
              </div>
              <div class="space-x-4">
                  <a href="/privacy-policy" class="text-slate-500 hover:text-slate-800 underline">隱私權政策</a>
                  <a href="/terms" class="text-slate-500 hover:text-slate-800 underline">服務條款</a>
              </div>
          </div>
      </footer>
  </div>
</BaseLayout>
