---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="複利滾存計算器 | SmartUtilBox"
    description="精準計算本金與定期定額的長期複利成長效應"
    currentPath="/compound"
    headerTitle="複利滾存計算器"
>
 <div class="max-w-5xl mx-auto"> <div class="lg:hidden mb-6"> <h1 class="text-2xl font-serif font-bold text-slate-900" data-i18n="header-title">複利滾存計算器</h1> <p class="mt-1 text-sm text-slate-500" data-i18n="header-subtitle">輕鬆規劃您的財富成長軌跡</p> </div> <div class="grid grid-cols-1 lg:grid-cols-12 gap-8"> <!-- Calculator Form --> <section class="md:col-span-4 bg-white p-6 rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 relative overflow-hidden border-none"> <h2 class="text-xl font-semibold mb-6 text-slate-800 border-b pb-2" data-i18n="input-title">輸入投資資訊</h2> <form id="compound-form" class="space-y-5"> <div> <label class="block text-sm font-medium text-slate-800 mb-1" data-i18n="input-principal">單筆投入本金 (Initial Principal)</label> <input type="text" inputmode="numeric" data-type="currency" id="initial-principal" class="block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border bg-slate-50 transition-colors" value="100,000"> </div> <div> <label class="block text-sm font-medium text-slate-800 mb-1" data-i18n="input-addition">定期定額投入 (Regular Addition)</label> <input type="text" inputmode="numeric" data-type="currency" id="regular-addition" class="block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border bg-slate-50 transition-colors" value="10,000"> </div> <div> <label class="block text-sm font-medium text-slate-800 mb-1" data-i18n="input-rate">年化報酬率 (%)</label> <input type="number" id="annual-rate" class="block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border bg-slate-50 transition-colors" value="5" min="0" step="0.1"> </div> <div> <label class="block text-sm font-medium text-slate-800 mb-1" data-i18n="input-years">投資年限 (年)</label> <input type="number" id="years" class="block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border bg-slate-50 transition-colors" value="10" min="1" max="100"> </div> <div> <label class="block text-sm font-medium text-slate-800 mb-1" data-i18n="input-freq">複利頻率</label> <select id="compound-frequency" class="block w-full rounded-md border-slate-200  focus:border-slate-800 focus:ring focus:ring-slate-400 focus:border-slate-400 focus:ring-opacity-50 p-2 border bg-slate-50 transition-colors font-medium"> <option value="1" data-i18n="opt-annual">每年 (Annually)</option> <option value="12" data-i18n="opt-monthly">每月 (Monthly)</option> </select> </div> </form> </section> <!-- Results Summary --> <section class="md:col-span-8 bg-white p-6 rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100"> <h2 class="text-xl font-semibold mb-6 text-slate-800 border-b pb-2" data-i18n="result-title">試算結果</h2> <!-- Dynamic Result Cards Area --> <div id="results-container" class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8"> <!-- Cards will be populated by JS --> </div> <h3 class="text-lg font-semibold mb-4 text-slate-800" data-i18n="table-title">年度成長明細表</h3> <div class="overflow-x-auto rounded-lg border-none"> <table class="min-w-full text-left text-sm whitespace-nowrap"> <thead class="bg-slate-50 border-b border-slate-200"> <tr> <th class="px-6 py-3 text-slate-500 font-semibold tracking-wider" data-i18n="th-year">年度</th> <th class="px-6 py-3 text-slate-500 font-semibold tracking-wider" data-i18n="th-principal">累積投入本金</th> <th class="px-6 py-3 text-slate-500 font-semibold tracking-wider" data-i18n="th-interest">當年利息</th> <th class="px-6 py-3 text-slate-500 font-semibold tracking-wider" data-i18n="th-total-interest">累積總報酬</th> <th class="px-6 py-3 text-slate-500 font-semibold tracking-wider" data-i18n="th-balance">期末總金額</th> </tr> </thead> <tbody id="growth-schedule" class="divide-y divide-gray-100 bg-white"> <!-- Rows will be populated by JS --> </tbody> </table> </div> </section> </div> </div> <!-- Quick Needs Submission Block --> <section class="bg-white text-slate-800 shadow-sm border-b border-slate-200 py-10 border-b border-blue-800 flex-shrink-0"> <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center"> <h2 class="text-2xl font-bold mb-4" data-i18n="footer-cta-title">對理財有疑問？留下一句話，讓我們開始對話。</h2> <form action="/contact" method="GET" class="flex flex-col sm:flex-row justify-center gap-4 max-w-xl mx-auto"> <input type="email" name="email" placeholder="您的 Email" class="px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-400 w-full sm:w-auto flex-1 shadow-sm" required> <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-white shadow-md font-semibold px-8 py-3 rounded-md transition duration-300 w-full sm:w-auto shadow-md" data-i18n="footer-cta-btn"> 開始諮詢 </button> </form> </div> </section> <!-- Footer inside main content --> <footer class="bg-slate-50 text-white py-6 mt-auto flex-shrink-0"> <div class="container mx-auto px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center text-sm max-w-5xl"> <div class="text-center sm:text-left mb-4 sm:mb-0"> <p>&copy; 2026 SmartUtilBox. All rights reserved.</p> <p class="mt-2 text-slate-400" data-i18n="footer-disclaimer">試算結果僅供參考，實際投資報酬可能因市場波動而有所不同。</p> </div> <div class="space-x-4"> <a href="/privacy-policy" class="hover:text-gray-300 underline transition-colors" data-i18n="footer-privacy">隱私權政策</a>
                        <a href="/about" class="text-slate-500 hover:text-slate-800 underline" data-i18n="footer-about">關於</a> <a href="/disclaimer" class="text-slate-500 hover:text-slate-800 underline" data-i18n="footer-disclaimer">免責聲明</a> <a href="/terms" class="text-slate-500 hover:text-slate-800 underline" class="hover:text-gray-300 underline transition-colors" data-i18n="footer-terms">服務條款</a> <a href="/blog" class="hover:text-gray-300 underline transition-colors" data-i18n="nav-guide">理財專欄</a> </div> </div> </footer>

<script is:inline>
</script>
</BaseLayout>
