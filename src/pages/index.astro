function updateTranslationsIndex() {
    const langSelector = document.getElementById('language-selector');
    const lang = langSelector ? langSelector.value : 'zh-tw';
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (i18nIndex[lang] && i18nIndex[lang][key]) {
            el.innerHTML = i18nIndex[lang][key];
        }
    });
}

document.addEventListener('DOMContentLoaded', () => {
    const langSelector = document.getElementById('language-selector');
    if (langSelector) {
        langSelector.addEventListener('change', updateTranslationsIndex);
    }
    updateTranslationsIndex();
});
</script>
