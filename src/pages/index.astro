---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadCapture from '../components/LeadCapture.astro';

const tools = [
  { href: '/mortgage', icon: '🏦', key: 'mortgage', title: '多國房貸試算', desc: '台灣寬限期、美國提前還款、英國蜜月期轉 SVR，算出月付金、總利息與還款明細。' },
  { href: '/rent-vs-buy', icon: '🏠', key: 'rvb', title: '買房 vs 租房', desc: '比較買房與「租房＋投資頭期款」在數年後的淨資產差距。' },
  { href: '/compound', icon: '📈', key: 'compound', title: '複利滾存計算', desc: '本金加每月投入，逐年看見複利如何放大資產。' },
  { href: '/dca-calculator', icon: '🗓️', key: 'dca', title: '定期定額 / 存股', desc: '試算長期定期定額投入 ETF 或存股的本金與收益變化。' },
  { href: '/inflation', icon: '🛡️', key: 'inflation', title: '通膨購買力', desc: '你的存款在 10 年、20 年後還剩多少實質購買力？' },
  { href: '/fire', icon: '🔥', key: 'fire', title: 'FIRE 提早退休', desc: '用 4% 法則估算財務自由目標，比較不同報酬率下的退休年齡。' },
  { href: '/portfolio-roi', icon: '🧮', key: 'portfolio', title: '投資組合加權報酬', desc: '計算資產佔比與加權報酬率，看出閒置現金的拖累。' },
  { href: '/exchange', icon: '💱', key: 'exchange', title: '匯率換算', desc: '主要貨幣即時匯率換算，出國與跨國匯款前先算一下。' },
];

const posts = (await getCollection('blog'))
  .filter((p) => !p.id.startsWith('en-'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout
    title="SmartUtilBox｜免費理財試算工具：房貸、複利、通膨、FIRE"
    description="免費線上理財試算工具箱：多國房貸、複利滾存、定期定額、買房 vs 租房、通膨購買力、FIRE 提早退休與投資組合分析。所有計算在瀏覽器本地完成。"
    currentPath="/"
    jsonLd={{ "@context": "https://schema.org", "@type": "WebSite", "name": "SmartUtilBox", "inLanguage": "zh-TW" }}
>
    <div class="px-2 sm:px-4 py-6 max-w-6xl mx-auto space-y-14">

        <section class="text-center py-12 md:py-16 bg-slate-900 text-white rounded-3xl shadow-xl px-6">
            <h1 class="text-3xl md:text-5xl font-serif font-bold mb-5 leading-tight">
                <span data-i18n="home-hero-title">買房、存錢、退休，先把數字算清楚</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-300 mb-8 max-w-2xl mx-auto">
                <span data-i18n="home-hero-desc">免費、免註冊的理財試算工具。你輸入的數字只在自己的瀏覽器裡計算，不會上傳。</span>
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/mortgage" class="px-8 py-4 bg-white text-slate-900 rounded-xl font-bold hover:bg-slate-100 transition-colors"><span data-i18n="home-btn1">開始房貸試算</span></a>
                <a href="/blog" class="px-8 py-4 bg-transparent border-2 border-slate-600 text-white rounded-xl font-bold hover:bg-slate-800 transition-colors"><span data-i18n="home-btn2">閱讀理財專欄</span></a>
            </div>
        </section>

        <section>
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-slate-900 mb-6 text-center"><span data-i18n="home-tools-title">所有試算工具</span></h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                {tools.map((t) => (
                    <a href={t.href} class="group bg-white rounded-2xl p-6 border border-slate-100 shadow-md hover:shadow-lg hover:border-slate-300 transition-all flex flex-col">
                        <span class="text-3xl mb-3" aria-hidden="true">{t.icon}</span>
                        <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-emerald-700"><span data-i18n={`home-tool-${t.key}-title`}>{t.title}</span></h3>
                        <p class="text-sm text-slate-600 flex-grow"><span data-i18n={`home-tool-${t.key}-desc`}>{t.desc}</span></p>
                    </a>
                ))}
            </div>
        </section>

        <section class="bg-white rounded-3xl p-6 md:p-10 shadow-md border border-slate-100">
            <h2 class="text-2xl font-serif font-bold text-slate-900 mb-6"><span data-i18n="home-posts-title">最新文章</span></h2>
            <ul class="divide-y divide-slate-100">
                {posts.map((p) => (
                    <li class="py-4">
                        <a href={`/blog/${p.id}/`} class="block group">
                            <p class="text-xs text-slate-400 mb-1">{p.data.pubDate.toISOString().slice(0, 10)}</p>
                            <h3 class="font-bold text-slate-900 group-hover:text-emerald-700">{p.data.title}</h3>
                            <p class="text-sm text-slate-600 mt-1 line-clamp-2">{p.data.description}</p>
                        </a>
                    </li>
                ))}
            </ul>
            <a href="/blog" class="inline-block mt-4 text-emerald-700 font-bold hover:text-emerald-600"><span data-i18n="home-posts-more">看全部文章 →</span></a>
        </section>

        <section class="grid md:grid-cols-3 gap-6 text-sm text-slate-600">
            <div class="bg-white rounded-2xl p-6 border border-slate-100">
                <h2 class="font-bold text-slate-900 mb-2 text-base"><span data-i18n="home-why1-title">計算在你的裝置上完成</span></h2>
                <p><span data-i18n="home-why1-desc">試算工具不需要登入，輸入的金額不會傳到我們的伺服器。</span></p>
            </div>
            <div class="bg-white rounded-2xl p-6 border border-slate-100">
                <h2 class="font-bold text-slate-900 mb-2 text-base"><span data-i18n="home-why2-title">公式公開透明</span></h2>
                <p><span data-i18n="home-why2-desc">每個工具頁都說明計算方式與假設，方便你自行驗算。</span></p>
            </div>
            <div class="bg-white rounded-2xl p-6 border border-slate-100">
                <h2 class="font-bold text-slate-900 mb-2 text-base"><span data-i18n="home-why3-title">工具，而不是推銷</span></h2>
                <p><span data-i18n="home-why3-desc">本站內容僅供教育參考，不推薦特定金融商品。<a href="/about" class="underline">了解本站</a></span></p>
            </div>
        </section>

        <LeadCapture />
    </div>
</BaseLayout>
