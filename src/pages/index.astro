    'en': {
        'home-hero-title': 'SmartUtilBox - Your Cross-Dimensional Asset Allocation Manager',
        'home-hero-desc': 'Driven by data and empirical testing, we help you build an inflation-resistant, highly tax-efficient global asset moat.',
        'home-btn1': 'Start Free Diagnosis',
        'home-btn2': 'Book Advisory Session',
