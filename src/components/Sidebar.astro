---
const { currentPath = '/' } = Astro.props;
// Utility to determine active class
const getActiveClass = (path: string) => {
  return currentPath === path || (path !== '/' && currentPath.startsWith(path + '/'))
    ? 'border-l-4 border-slate-800 bg-slate-100 text-slate-900 font-bold font-medium'
    : '';
};
---

<div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-70 z-20 hidden lg:hidden"></div>

<aside id="sidebar" class="bg-white w-64 flex-shrink-0 border-r border-slate-100 flex flex-col transition-transform transform -translate-x-full lg:translate-x-0 fixed inset-y-0 left-0 z-30 lg:static lg:block h-screen overflow-y-auto hide-scrollbar">
    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
        <h2 class="text-2xl font-serif font-bold text-slate-900">SmartUtilBox</h2>
        <button id="close-sidebar" class="lg:hidden text-slate-400 hover:text-white focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>
    <div class="p-4 overflow-y-auto flex-grow">
        <!-- Group A: Tools -->
        <div class="mb-8">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3" data-i18n="nav-group-tools">實用工具</h3>
            <ul class="space-y-2">
                <li>
                    <a href="/" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/')}`} data-i18n="nav-home">首頁</a>
                </li>
                <li>
                    <a href="/exchange" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/exchange')}`} data-i18n="nav-exchange">匯率換算</a>
                </li>
                <li>
                    <a href="/mortgage" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/mortgage')}`} data-i18n="nav-mortgage">多國房貸試算中心</a>
                </li>
                <li>
                    <a href="/compound" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/compound')}`} data-i18n="nav-compound">複利滾存計算器</a>
                </li>
                <li>
                    <a href="/dca-calculator" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/dca-calculator')}`} data-i18n="nav-dca">定期定額 / 存股複利試算</a>
                </li>
                <li>
                    <a href="/rent-vs-buy" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/rent-vs-buy')}`} data-i18n="nav-rvb">買房 vs 租房決策試算</a>
                </li>
                <li>
                    <a href="/inflation" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/inflation')}`} data-i18n="nav-inflation">通膨與購買力試算</a>
                </li>
            </ul>
        </div>
        <!-- Group B: Diagnosis -->
        <div class="mb-8">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3" data-i18n="nav-group-diag">深度財務診斷</h3>
            <ul class="space-y-2">
                <li>
                    <a href="/fire" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/fire')}`} data-i18n="nav-fire">FIRE 提早退休試算</a>
                </li>
                <li>
                    <a href="/portfolio-roi" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/portfolio-roi')}`} data-i18n="nav-portfolio">投資組合 X-Ray</a>
                </li>
            </ul>
        </div>
        <!-- Group C: Services -->
        <div class="mb-8">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3" data-i18n="nav-group-services">顧問與服務</h3>
            <ul class="space-y-2">
                <li>
                    <a href="/blog" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/blog')}`} data-i18n="nav-guide">理財專欄</a>
                </li>
                <li>
                    <a href="/coaching" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/coaching')}`} data-i18n="nav-coaching">一對一教練服務</a>
                </li>
                <li>
                    <a href="/contact" class={`block px-4 py-2 rounded-md text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors ${getActiveClass('/contact')}`} data-i18n="nav-contact">聯繫顧問</a>
                </li>
            </ul>
        </div>
    </div>
</aside>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const sidebar = document.getElementById('sidebar');
        const openSidebarBtn = document.getElementById('open-sidebar');
        const closeSidebarBtn = document.getElementById('close-sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');

        if(sidebar && sidebarOverlay) {
            function openSidebar() {
                sidebar.classList.remove('-translate-x-full');
                sidebarOverlay.classList.remove('hidden');
            }

            function closeSidebar() {
                sidebar.classList.add('-translate-x-full');
                sidebarOverlay.classList.add('hidden');
            }

            if(openSidebarBtn) openSidebarBtn.addEventListener('click', openSidebar);
            if(closeSidebarBtn) closeSidebarBtn.addEventListener('click', closeSidebar);
            sidebarOverlay.addEventListener('click', closeSidebar);
        }
    });
</script>
