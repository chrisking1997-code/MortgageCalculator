---
const { title = "多國房貸利息試算中心" } = Astro.props;
---

<header class="bg-slate-900 text-white py-4 px-6 shadow-md border-b border-slate-800 flex justify-between items-center z-10 flex-shrink-0">
    <div class="flex items-center">
        <button id="open-sidebar" class="mr-4 lg:hidden text-white focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
        <div class="hidden lg:block">
            <a href="/" class="text-xl font-serif font-bold text-white" id="header-title" data-i18n="title">{title}</a>
        </div>
    </div>
    <div class="flex items-center space-x-4">
        <a href="/blog" class="text-white hover:text-white transition-colors font-medium text-sm lg:text-base underline" data-i18n="nav-guide">理財專欄</a>
        <div class="flex items-center space-x-2">
            <span class="text-slate-300 text-sm font-medium">Language:</span>
            <select id="language-selector" class="bg-white text-slate-900 font-semibold text-sm rounded border-2 border-slate-300 outline-none px-2 py-1 border border-slate-700 focus:ring focus:ring-slate-400 focus:outline-none">
                <option value="zh-tw">中文</option>
                <option value="en">English</option>
            </select>
        </div>
    </div>
</header>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const langSelector = document.getElementById('language-selector');
    if (langSelector) {
        const savedLang = localStorage.getItem('calc-lang');
        if (savedLang && (savedLang === 'zh-tw' || savedLang === 'en')) {
            langSelector.value = savedLang;
        }

        langSelector.addEventListener('change', (e) => {
            localStorage.setItem('calc-lang', e.target.value);
            // Dynamic translation logic happens within specific pages if needed
            // OR global reload if structured that way.
        });
    }
});
</script>
